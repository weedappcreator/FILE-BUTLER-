#!/bin/bash
# file-butler — Mac File Organization Tool
# https://github.com/weedappcreator/FILE-BUTLER-

export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

VERSION="2.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="$HOME/.file-butler.log"
DRY_RUN=true

# ─── Colors ───────────────────────────────────────────────
RED='\033[0;31m';  GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m';  BOLD='\033[1m';  NC='\033[0m'

ok()     { echo -e "${GREEN}✅ $1${NC}"; }
err()    { echo -e "${RED}❌ $1${NC}"; }
warn()   { echo -e "${YELLOW}⚠️  $1${NC}"; }
info()   { echo -e "${CYAN}ℹ️  $1${NC}"; }
dry_e()  { echo -e "  ${YELLOW}›${NC} $1"; }
log()    { echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

header() {
    echo ""
    echo -e "${BLUE}${BOLD}══════════════════════════════════════${NC}"
    echo -e "${BLUE}${BOLD}  $1${NC}"
    echo -e "${BLUE}${BOLD}══════════════════════════════════════${NC}"
}

# ─── File type detection (bash 3.2 compatible) ────────────
get_file_type() {
    local ext
    ext=$(echo "$1" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    case "$ext" in
        pdf|doc|docx|txt|pptx|pages|numbers|keynote|odt|rtf|md|csv|xlsx|xls)
            echo "Documents" ;;
        jpg|jpeg|png|gif|svg|webp|bmp|ico|heic|tiff|raw|eps|psd|ai|webp)
            echo "Images" ;;
        mp4|mov|avi|mkv|flv|wmv|webm|m4v|mpg|mpeg|3gp|mp|gif)
            echo "Videos" ;;
        mp3|wav|aac|flac|m4a|wma|ogg|opus|alac|aiff)
            echo "Audio" ;;
        js|ts|jsx|tsx|py|java|go|rs|cpp|c|h|swift|kt|rb|php|css|html|json|xml|yaml|yml|sh|bash|pl|lua|r|scala|dart|vue|sql|env)
            echo "Code" ;;
        zip|tar|gz|rar|7z|bz2|xz|iso|bz)
            echo "Archives" ;;
        dmg|pkg|exe|app|jar)
            echo "Installers" ;;
        fig|figma|sketch|xd|indd)
            echo "Design" ;;
        eml|mhtml|mbox)
            echo "Email" ;;
        *)
            echo "" ;;
    esac
}

# ─── Dependency check ─────────────────────────────────────
check_deps() {
    local missing=0
    command -v f2  &>/dev/null || { err "F2 not installed — run: file-butler --install"; missing=1; }
    command -v rnr &>/dev/null || { err "RnR not installed — run: file-butler --install"; missing=1; }
    [ $missing -eq 1 ] && exit 1
    return 0
}

# ─── Step 1: Rename files with YYYY-MM-DD prefix ──────────
rename_with_dates() {
    local dir="$1"
    local count=0

    header "Step 1 — Date Rename"
    info "Adding YYYY-MM-DD prefix to all files..."

    while IFS= read -r file; do
        local base parent fdate new_name
        base=$(basename "$file")
        parent=$(dirname "$file")

        [[ "$base" == .* ]] && continue
        [[ "$base" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_ ]] && continue

        fdate=$(stat -f %Sm -t "%Y-%m-%d" "$file" 2>/dev/null || date +%Y-%m-%d)
        new_name="${fdate}_${base}"

        if [ "$DRY_RUN" = true ]; then
            dry_e "$base  →  $new_name"
        else
            mv "$file" "$parent/$new_name" 2>/dev/null && log "Renamed: $base → $new_name"
        fi
        count=$((count + 1))
    done < <(find "$dir" -maxdepth 1 -type f ! -name ".*" 2>/dev/null)

    [ $count -eq 0 ] && info "All files already have date prefix" || ok "$count file(s) renamed"
}

# ─── Step 2: Organize files into type folders ─────────────
organize_files() {
    local dir="$1"
    local moved=0 skipped=0

    header "Step 2 — Organize by Type"
    info "Sorting files into type folders..."

    while IFS= read -r file; do
        local base ext type target
        base=$(basename "$file")
        [[ "$base" == .* ]] && continue

        ext="${base##*.}"
        [ "$ext" = "$base" ] && ext=""

        type=$(get_file_type "$ext")

        # No known type — skip, leave in place
        if [ -z "$type" ]; then
            skipped=$((skipped + 1))
            continue
        fi

        target="$dir/$type"
        [ "$(dirname "$file")" = "$target" ] && continue

        if [ "$DRY_RUN" = true ]; then
            dry_e "$base  →  $type/"
        else
            mkdir -p "$target"
            mv "$file" "$target/$base" 2>/dev/null && log "Organized: $base → $type/"
        fi
        moved=$((moved + 1))
    done < <(find "$dir" -maxdepth 1 -type f ! -name ".*" 2>/dev/null)

    [ $moved -eq 0 ] && info "No files to organize" || ok "$moved file(s) organized"
    [ $skipped -gt 0 ] && info "$skipped file(s) skipped (unknown type — left in place)"
}

# ─── Step 3: Move existing folders into Projects/ ─────────
organize_folders() {
    local dir="$1"
    local moved=0

    header "Step 3 — Project Folders"
    info "Moving project folders into Projects/..."

    # These are protected type/system folders — never move
    local protected="Documents Images Videos Audio Code Archives Installers Design Email Projects Other"

    while IFS= read -r item; do
        local name
        name=$(basename "$item")

        # Skip protected folders
        echo "$protected" | tr ' ' '\n' | grep -qx "$name" && continue

        if [ "$DRY_RUN" = true ]; then
            dry_e "$name/  →  Projects/$name/"
        else
            mkdir -p "$dir/Projects"
            mv "$item" "$dir/Projects/$name" 2>/dev/null && log "Moved folder: $name → Projects/"
        fi
        moved=$((moved + 1))
    done < <(find "$dir" -maxdepth 1 -mindepth 1 -type d ! -name ".*" 2>/dev/null)

    [ $moved -eq 0 ] && info "No loose folders found" || ok "$moved folder(s) moved to Projects/"
}

# ─── Summary ──────────────────────────────────────────────
show_summary() {
    local dir="$1"
    header "Summary — $(basename "$dir")"
    for d in "$dir"/*/; do
        [ -d "$d" ] || continue
        local count name
        count=$(find "$d" -maxdepth 1 -type f | wc -l | tr -d ' ')
        name=$(basename "$d")
        [ "$count" -gt 0 ] && echo -e "  ${CYAN}$name/${NC}  →  $count files"
    done
}

# ─── Interactive mode ─────────────────────────────────────
interactive_mode() {
    header "file-butler v${VERSION}"
    echo -e "  ${BOLD}Mac File Organization Tool${NC}"
    echo ""

    echo -e "${BOLD}Where do you want to organize?${NC}"
    echo "  1) Downloads"
    echo "  2) Desktop"
    echo "  3) Documents"
    echo "  4) Entire home (~)"
    echo "  5) Custom path"
    echo ""
    printf "  Choice [1-5]: "
    read -r choice

    local target
    case "$choice" in
        1) target="$HOME/Downloads" ;;
        2) target="$HOME/Desktop" ;;
        3) target="$HOME/Documents" ;;
        4) target="$HOME" ;;
        5)
            printf "  Enter path: "
            read -r target
            target="${target/#\~/$HOME}"
            ;;
        *) err "Invalid choice"; exit 1 ;;
    esac

    echo ""
    echo -e "${BOLD}What should be organized?${NC}"
    echo "  1) Files + Folders (full organize)"
    echo "  2) Files only (rename + sort by type)"
    echo "  3) Rename only (YYYY-MM-DD prefix)"
    echo ""
    printf "  Choice [1-3]: "
    read -r mode

    echo ""
    echo -e "${BOLD}Preview first? (recommended)${NC}"
    printf "  Dry-run first? [Y/n]: "
    read -r confirm
    confirm=$(echo "$confirm" | tr '[:upper:]' '[:lower:]')

    if [ "$confirm" != "n" ]; then
        DRY_RUN=true
        run_organize "$target" "$mode"
        echo ""
        printf "${YELLOW}  Apply these changes? [y/N]: ${NC}"
        read -r apply
        apply=$(echo "$apply" | tr '[:upper:]' '[:lower:]')
        if [ "$apply" = "y" ]; then
            DRY_RUN=false
            run_organize "$target" "$mode"
            show_summary "$target"
        else
            info "Cancelled — no files were moved"
        fi
    else
        DRY_RUN=false
        run_organize "$target" "$mode"
        show_summary "$target"
    fi
}

run_organize() {
    local dir="$1"
    local mode="$2"

    [ ! -d "$dir" ] && { err "Directory not found: $dir"; exit 1; }

    [ "$DRY_RUN" = true ] && warn "DRY-RUN — no files will be moved"

    case "$mode" in
        1)
            rename_with_dates "$dir"
            organize_files    "$dir"
            organize_folders  "$dir"
            ;;
        2)
            rename_with_dates "$dir"
            organize_files    "$dir"
            ;;
        3)
            rename_with_dates "$dir"
            ;;
        *)
            rename_with_dates "$dir"
            organize_files    "$dir"
            organize_folders  "$dir"
            ;;
    esac
}

# ─── Install dependencies ─────────────────────────────────
install_deps() {
    header "Installing file-butler dependencies"

    mkdir -p ~/bin
    local arch
    arch=$(uname -m)

    # Install F2
    echo ""
    info "Installing F2 (batch rename)..."
    local f2_url
    if [ "$arch" = "arm64" ]; then
        f2_url="https://github.com/ayoisaiah/f2/releases/download/v2.2.2/f2_2.2.2_darwin_arm64.tar.gz"
    else
        f2_url="https://github.com/ayoisaiah/f2/releases/download/v2.2.2/f2_2.2.2_darwin_amd64.tar.gz"
    fi
    curl -sL "$f2_url" -o /tmp/f2.tar.gz && tar -xzf /tmp/f2.tar.gz -C /tmp && mv /tmp/f2 ~/bin/f2 && chmod +x ~/bin/f2
    ok "F2 installed"

    # Install RnR
    echo ""
    info "Installing RnR (regex rename)..."
    local rnr_url
    if [ "$arch" = "arm64" ]; then
        rnr_url="https://github.com/ismaelgv/rnr/releases/download/v0.5.1/rnr-v0.5.1-aarch64-apple-darwin.tar.gz"
    else
        rnr_url="https://github.com/ismaelgv/rnr/releases/download/v0.5.1/rnr-v0.5.1-x86_64-apple-darwin.tar.gz"
    fi
    curl -sL "$rnr_url" -o /tmp/rnr.tar.gz
    mkdir -p /tmp/rnr_extract && tar -xzf /tmp/rnr.tar.gz -C /tmp/rnr_extract
    cp "$(find /tmp/rnr_extract -type f -name "rnr" | head -1)" ~/bin/rnr && chmod +x ~/bin/rnr
    rm -rf /tmp/rnr_extract /tmp/rnr.tar.gz
    ok "RnR installed"

    # Add to PATH
    local shell_rc="$HOME/.zshrc"
    [ -f "$HOME/.bashrc" ] && shell_rc="$HOME/.bashrc"
    if ! grep -q 'file-butler' "$shell_rc" 2>/dev/null; then
        echo '' >> "$shell_rc"
        echo '# file-butler' >> "$shell_rc"
        echo 'export PATH="$HOME/bin:$PATH"' >> "$shell_rc"
        ok "Added ~/bin to PATH in $shell_rc"
    fi

    echo ""
    ok "All done! Run: file-butler"
    info "Tip: Open a new terminal or run: source ~/.zshrc"
}

# ─── Help ─────────────────────────────────────────────────
show_help() {
    echo ""
    echo -e "${BLUE}${BOLD}file-butler v${VERSION}${NC} — Mac File Organization Tool"
    echo ""
    echo -e "${CYAN}USAGE:${NC}"
    echo "  file-butler                      Interactive mode (recommended)"
    echo "  file-butler --dry-run            Preview all changes"
    echo "  file-butler --execute            Run without prompts"
    echo "  file-butler --path <dir>         Target a specific directory"
    echo "  file-butler --install            Install F2 + RnR dependencies"
    echo "  file-butler --log                Show activity log"
    echo "  file-butler --help               Show this help"
    echo ""
    echo -e "${CYAN}EXAMPLES:${NC}"
    echo "  file-butler"
    echo "  file-butler --path ~/Downloads --dry-run"
    echo "  file-butler --path ~/Downloads --execute"
    echo ""
}

# ─── Main ─────────────────────────────────────────────────
main() {
    local custom_path=""
    local mode="1"
    local explicit_run=false

    [ $# -eq 0 ] && { interactive_mode; exit 0; }

    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h)      show_help; exit 0 ;;
            --version|-v)   echo "file-butler v$VERSION"; exit 0 ;;
            --install)      install_deps; exit 0 ;;
            --dry-run)      DRY_RUN=true;  explicit_run=true; shift ;;
            --execute)      DRY_RUN=false; explicit_run=true; shift ;;
            --path)         custom_path="$2"; shift 2 ;;
            --rename-only)  mode="3"; shift ;;
            --files-only)   mode="2"; shift ;;
            --log)          [ -f "$LOG_FILE" ] && tail -50 "$LOG_FILE"; exit 0 ;;
            *) err "Unknown option: $1"; show_help; exit 1 ;;
        esac
    done

    check_deps

    if [ -n "$custom_path" ] && [ "$explicit_run" = true ]; then
        local expanded="${custom_path/#\~/$HOME}"
        [ "$DRY_RUN" = true ] && warn "DRY-RUN — no files will be moved"
        run_organize "$expanded" "$mode"
        [ "$DRY_RUN" = false ] && show_summary "$expanded"
    else
        interactive_mode
    fi
}

main "$@"
